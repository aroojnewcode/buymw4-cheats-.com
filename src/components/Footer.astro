---
import {
  getTranslations,
  localizePath,
  resolveLocale,
  type Locale,
} from '../i18n';
import { Separator } from '@/components/starwind/separator';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const t = getTranslations(locale);
const L = (path: string) => localizePath(locale, path);

const resourceLinks = [
  { href: L('/blog/'), label: 'Blog articles index', ariaLabel: t.blog.eyebrow },
  { href: L('/products/mw4-cheats/elite/'), label: t.cheats.title, ariaLabel: 'Elite tier product page' },
  { href: L('/products/mw4-cheats/'), label: 'MW4 product comparison hub', ariaLabel: t.products.eyebrow },
  { href: L('/support/'), label: 'Email & Discord support', ariaLabel: t.footer.support },
];

const legalLinks = [
  { href: L('/about/'), label: 'Legal hub — About us' },
  { href: L('/privacy/'), label: t.footer.privacy },
  { href: L('/terms/'), label: t.footer.terms },
];

/** Discover priority-locale pages (reduces sitemap orphans). */
const localeDiscoveryLinks = [
  { href: '/ko/about/', label: 'KO — About Modern Warfare Cheats' },
  { href: '/ko/blog/how-to-buy-mw4-cheats-2026/', label: 'KO — How to buy MW4 cheats (2026)' },
  { href: '/ko/blog/how-to-use-mw4-cheat-codes/', label: 'KO — MW4 cheat codes guide' },
  { href: '/ko/blog/mw4-aimbot-combat-guide/', label: 'KO — MW4 aimbot combat guide' },
  { href: '/ko/blog/mw4-aimbot-ranked-guide/', label: 'KO — MW4 aimbot ranked guide' },
  { href: '/ko/blog/mw4-cheats-features-guide/', label: 'KO — MW4 cheats features guide' },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href={L('/')} class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold" aria-label={t.ui.homeAria}>
          <img src="/logo.svg" alt="Modern Warfare Cheats logo" width="32" height="32" class="rounded-md" />
          <span aria-hidden="true">Modern Warfare<span class="text-primary">Cheats</span></span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={L(link.href)}
                class="text-sm text-muted-foreground hover:text-primary"
                aria-label={link.ariaLabel}
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary" aria-label={link.ariaLabel}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <nav class="mb-6" aria-label="Korean site guides">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">한국어 (KO) guides</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {localeDiscoveryLinks.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
