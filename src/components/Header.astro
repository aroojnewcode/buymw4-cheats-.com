---
import {
  getTranslations,
  localizePath,
  resolveLocale,
  type Locale,
} from '../i18n';
import { checkoutPath } from '../config/checkout';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';
import type { IconName } from './icons/types';
import { PRODUCT_BASE, BRAND_ICON, BRAND_ICON_2X } from '../config/site';

interface Props {
  locale?: Locale;
  brandIconAlt?: string;
}

const locale = resolveLocale(Astro.props.locale);
const brandIconAlt = Astro.props.brandIconAlt ?? 'MW4 Cheats site icon';
const t = getTranslations(locale);
const homeHref = localizePath(locale, '/');

const navIconsByHref: Record<string, IconName> = {
  '/': 'navHome',
  [PRODUCT_BASE]: 'navProducts',
  '/blog/': 'navBlog',
  '/forum/': 'messageCircle',
  '/faq/': 'navFaq',
  '/support/': 'navSupport',
};

const purchaseUrl = checkoutPath('mw4');
const nav = t.nav.map((link) => {
  const bareHref = link.href;
  return {
    ...link,
    bareHref,
    href: localizePath(locale, bareHref),
    icon: (navIconsByHref[bareHref] ?? 'navFeatures') as IconName,
  };
});
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="site-header-bar pointer-events-auto relative flex h-14 w-full max-w-6xl items-center justify-between gap-2 rounded-2xl border border-border/40 bg-background/35 px-3 text-foreground shadow-md shadow-black/5 backdrop-blur-2xl supports-[backdrop-filter]:bg-background/25 dark:border-white/10 dark:bg-background/20 dark:shadow-black/25 sm:px-4 lg:h-[3.75rem] lg:gap-3 lg:px-4 xl:px-5"
    >
      <div class="site-header-brand flex min-w-0 shrink-0 items-center lg:w-[11.5rem] xl:w-[13rem]">
        <a
          href={homeHref}
          class="inline-flex min-w-0 max-w-full items-center gap-2 font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-wide sm:text-lg"
          aria-label={t.ui.homeAria}
        >
          <img
            src={BRAND_ICON}
            srcset={`${BRAND_ICON} 1x, ${BRAND_ICON_2X} 2x`}
            alt={brandIconAlt}
            width={32}
            height={32}
            class="size-8 shrink-0 rounded-md object-contain"
            decoding="async"
          />
          <span class="truncate text-base leading-none sm:text-lg" aria-hidden="true">
            MW4 <span class="text-primary">Cheats</span>
          </span>
        </a>
      </div>

      <nav
        class="site-header-nav pointer-events-none absolute left-1/2 top-1/2 hidden max-w-[calc(100%-10.5rem)] -translate-x-1/2 -translate-y-1/2 items-center justify-center gap-0 lg:flex xl:max-w-[calc(100%-12rem)] xl:gap-0.5"
        aria-label="Primary"
      >
        {nav.map((link) => (
          <a
            href={link.href}
            class="nav-link pointer-events-auto inline-flex items-center gap-1 rounded-md px-1 py-1.5 text-[0.8125rem] font-medium leading-none text-muted-foreground transition-colors hover:text-primary xl:gap-1.5 xl:px-2 xl:text-sm"
            data-nav-link
            {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
          >
            <Icon name={link.icon} size={16} class="hidden shrink-0 xl:inline" />
            <span class="whitespace-nowrap">{link.label}</span>
          </a>
        ))}
      </nav>

      <div class="site-header-end flex w-auto shrink-0 items-center justify-end gap-1 sm:gap-1.5 lg:min-w-[11.5rem] xl:min-w-[13rem]">
        <div class="site-header-actions flex items-center gap-1 sm:gap-1.5">
          <LanguageSwitcher locale={locale} class="shrink-0" />
          <SlideRevealButton href={purchaseUrl} class="hidden shrink-0 lg:inline-flex" ariaLabel={t.ui.checkoutAria}>
            {t.ui.browseCheats}
          </SlideRevealButton>
          <div class="nav-action-divider hidden h-9 shrink-0 items-center px-0.5 lg:flex" aria-hidden="true">
            <span class="block h-6 w-px bg-border"></span>
          </div>
          <div class="hidden h-9 shrink-0 items-center sm:flex">
            <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="inline-flex size-9 items-center justify-center" />
          </div>
        </div>

        <Sheet class="shrink-0 lg:hidden">
          <SheetTrigger
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted"
            aria-label={t.ui.menuOpen}
          >
            <Icon name="menu" size={20} />
          </SheetTrigger>
          <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
            <SheetHeader>
              <p class="text-base font-semibold leading-none">{t.site.name}</p>
            </SheetHeader>
            <nav class="flex flex-col gap-1" aria-label="Mobile primary">
              {nav.map((link) => (
                <a
                  href={link.href}
                  class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
                  data-nav-link
                  {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                >
                  <Icon name={link.icon} size={16} />
                  {link.label}
                </a>
              ))}
            </nav>
            <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria}>
              {t.ui.browseCheatsMobile}
            </Button>
            <div class="flex justify-center pt-1">
              <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} />
            </div>
          </SheetContent>
        </Sheet>
      </div>
    </div>
  </div>
</header>
