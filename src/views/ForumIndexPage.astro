---
import '../styles/forum.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/icons/Icon.astro';
import { forumCategories, forumPosts } from '../data/forum';
import { BRAND_ICON, BRAND_ICON_2X } from '../config/site';
import { blogPosts, getBlogPostTimestamp } from '../data/blog';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../utils/schema';
import {
  getTranslations,
  localizePath,
  type Locale,
} from '../i18n';
import { forumPostPath, normalizeInternalPath } from '../utils/path';
import {
  getForumShell,
  localizeForumCategory,
  localizeForumPost,
} from '../i18n/forum-i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const L = (path: string) => localizePath(locale, path);
const seo = resolvePageSeo('/forum/', locale);
const shell = getForumShell(locale);
const localizedPosts = forumPosts.map((post) => localizeForumPost(locale, post));
const forumPath = L('/forum/');
const breadcrumbs = [
  { name: t.ui.breadcrumbHome, path: L('/') },
  { name: 'Community forum hub', path: forumPath },
];
const categoryKey = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, '');
const sourceTimestamp = (path?: string) => {
  const slug = path?.split('/').filter(Boolean).at(-1);
  const article = blogPosts.find((item) => item.slug === slug);
  return article ? getBlogPostTimestamp(article.date) : 0;
};
const localizeHref = (href?: string) => {
  if (!href) return L('/blog/');
  const normalized = normalizeInternalPath(href);
  return normalized.startsWith('http') ? normalized : L(normalized);
};
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: seo.title,
      description: seo.description,
      url: forumPath,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section
    class="forum-page py-8 md:py-12"
    data-i18n-discussion={shell.discussion}
    data-i18n-discussions={shell.discussions}
    data-i18n-showing={shell.showingRange}
    data-i18n-zero={shell.zeroDiscussions}
    data-i18n-page={shell.pageAria}
    data-i18n-guide-label={shell.guideDiscussionsLabel}
  >
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="forum-hero">
        <div>
          <p class="section-header__eyebrow">{t.nav.find((n) => n.href === '/forum/')?.label ?? 'Forum'}</p>
          <h1 class="forum-hero__title">{seo.h1 ?? seo.title}</h1>
          <p class="forum-hero__lead">{seo.description}</p>
        </div>
        <a class="forum-create" href={L('/blog/')}>
          <Icon name="messageCircle" size={17} />
          Browse setup guides
        </a>
      </header>

      <div class="forum-layout">
        <main class="forum-main" aria-label={shell.postsAria}>
          <div class="forum-toolbar">
            <div class="forum-sort" role="group" aria-label={shell.sortAria}>
              <button class="is-active" type="button" data-forum-sort="popular" aria-pressed="true">{shell.popular}</button>
              <button type="button" data-forum-sort="latest" aria-pressed="false">{shell.latest}</button>
              <button type="button" data-forum-sort="top" aria-pressed="false">{shell.top}</button>
            </div>
            <label class="forum-search">
              <Icon name="search" size={16} />
              <input type="search" placeholder={shell.searchPlaceholder} aria-label={shell.searchPlaceholder} data-forum-search />
              <span class="sr-only" data-forum-count>{forumPosts.length} {shell.discussions}</span>
            </label>
          </div>

          <div class="forum-category-filters" role="group" aria-label={shell.filterByTopicAria}>
            <button type="button" class="is-active" data-forum-filter="all" aria-pressed="true">
              <Icon name="layers" size={14} /> {shell.allTopics}
            </button>
            {
              forumCategories.map((category) => (
                <button type="button" data-forum-filter={categoryKey(category.name)} aria-pressed="false">
                  <Icon name={category.icon} size={14} /> {localizeForumCategory(locale, category.name)}
                </button>
              ))
            }
          </div>
          <p class="forum-results-count" data-forum-visible-count>
            {forumPosts.length} {shell.guideDiscussionsLabel}
          </p>

          <div class="forum-post-list" aria-live="polite">
            {
              localizedPosts.map((post, index) => (
                <article
                  class="forum-post-card"
                  data-forum-card
                  data-post-slug={post.slug}
                  data-upvotes={post.upvotes}
                  data-category={categoryKey(post.category)}
                  data-comments={post.commentsCount}
                  data-published={sourceTimestamp(post.sourcePath)}
                  data-order={index}
                >
                  <div class="forum-vote" aria-label={shell.discussionVotingAria}>
                    <button class="forum-vote__up" type="button" data-vote-up aria-label={shell.upvoteAria}>
                      <Icon name="chevronDown" size={16} />
                    </button>
                    <strong data-vote-count>{post.upvotes}</strong>
                    <button type="button" disabled aria-label={shell.downvoteUnavailableAria}>
                      <Icon name="chevronDown" size={16} />
                    </button>
                  </div>
                  <div class="forum-post-card__body">
                    <div class="forum-post-meta">
                      <span class={`forum-community-avatar tone-${post.categoryTone}`}>
                        <Icon name="users" size={15} />
                      </span>
                      <a href="#communities" class="forum-community-name">
                        d/{post.category.toLowerCase().replaceAll(' ', '')}
                      </a>
                      <span>·</span>
                      <span>
                        <Icon name="userRound" size={13} /> {shell.guideTeam}
                      </span>
                      <span>{shell.guideBasedQa}</span>
                    </div>
                    <a class="forum-post-title" href={forumPostPath(post.slug, locale)}>
                      {post.title}
                    </a>
                    <p class="forum-post-excerpt">{post.excerpt}</p>
                    {
                      post.sourceTitle && (
                        <p class="forum-source">
                          {shell.fromTheGuide}{' '}
                          <a href={localizeHref(post.sourcePath)}>Guide #{index + 1}: {post.sourceTitle}</a>
                        </p>
                      )
                    }
                    <div class="forum-post-actions">
                      {post.flair && <span class={`forum-flair tone-${post.categoryTone}`}>{post.flair}</span>}
                      <a href={`${forumPostPath(post.slug, locale)}#comments`}>
                        <Icon name="messageCircle" size={15} /> {post.commentsCount} replies · {post.slug}
                      </a>
                      <a href={forumPostPath(post.slug, locale)}>
                        <Icon name="arrowRight" size={15} /> Open thread: {post.title}
                      </a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
          <p class="forum-empty" data-forum-empty hidden>{shell.emptyState}</p>
          <nav class="forum-pagination" aria-label={shell.paginationAria} data-forum-pagination hidden>
            <button type="button" data-page-previous aria-label={shell.previousPageAria}>{shell.previous}</button>
            <div class="forum-pagination__pages" data-page-buttons></div>
            <button type="button" data-page-next aria-label={shell.nextPageAria}>{shell.next}</button>
            <span class="forum-pagination__status" data-page-status aria-live="polite"></span>
          </nav>
        </main>

        <aside class="forum-sidebar">
          <section class="forum-side-card forum-about" id="community-guidelines">
            <div class="forum-side-card__banner"></div>
            <div class="forum-about__content">
              <div class="forum-about__title">
                <span class="forum-community-avatar forum-community-avatar--brand">
                  <img
                    src={BRAND_ICON}
                    srcset={`${BRAND_ICON} 1x, ${BRAND_ICON_2X} 2x`}
                    alt="Forum – favicon"
                    width={34}
                    height={34}
                  />
                </span>
                <h2>Forum: Modern Warfare Cheats</h2>
              </div>
              <p>{shell.communityLead}</p>
              <div class="forum-stats">
                <span><b>{forumPosts.length}</b> {shell.guideDiscussionsLabel}</span>
                <span><b>{forumCategories.length}</b> {shell.topics}</span>
              </div>
              <a class="forum-join" href={L('/blog/')}>Open the Modern Warfare guide library</a>
            </div>
          </section>
          <section class="forum-side-card" id="communities">
            <h2 class="forum-side-heading">{shell.communitiesHeading}</h2>
            <ul class="forum-community-list">
              {
                forumCategories.map((category) => (
                  <li>
                    <a href={`${forumPath}?category=${categoryKey(category.name)}`}>
                      <span class={`forum-community-avatar tone-${category.tone}`} aria-hidden="true">
                        <Icon name={category.icon} size={15} />
                      </span>
                      <span>
                        <b>{localizeForumCategory(locale, category.name)}</b>
                        <small>{shell.browseRelatedQa}</small>
                      </span>
                      <Icon name="chevronRight" size={15} />
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="forum-text-link" href="#communities">
              {shell.browseAllCommunities} <Icon name="arrowRight" size={14} />
            </a>
          </section>
          <section class="forum-side-card forum-rules">
            <h2 class="forum-side-heading">{shell.communityGuidelinesHeading}</h2>
            <ol>
              <li>{shell.guidelineFriendly}</li>
              <li>{shell.guidelineOnTopic}</li>
              <li>{shell.guidelineSpoilers}</li>
            </ol>
            <a href="#community-guidelines">
              {shell.readFullGuidelines} <Icon name="arrowRight" size={14} />
            </a>
          </section>
          <p class="forum-sidebar-foot">
            <a href={L('/about/')}>{t.footer.about}</a> ·{' '}
            <a href={L('/privacy/')}>{t.footer.privacy}</a> ·{' '}
            <a href={L('/terms/')}>{t.footer.terms}</a>
            <br />© {new Date().getFullYear()} {shell.copyrightSuffix}
          </p>
        </aside>
      </div>
    </div>
  </section>
  <script>
    const pageRoot = document.querySelector('.forum-page');
    const labelDiscussion = pageRoot?.dataset.i18nDiscussion ?? 'discussion';
    const labelDiscussions = pageRoot?.dataset.i18nDiscussions ?? 'discussions';
    const labelShowing = pageRoot?.dataset.i18nShowing ?? 'Showing';
    const labelZero = pageRoot?.dataset.i18nZero ?? '0 discussions';
    const labelGuide = pageRoot?.dataset.i18nGuideLabel ?? 'guide discussions';
    const cards = [...document.querySelectorAll('[data-forum-card]')];
    const sortButtons = [...document.querySelectorAll('[data-forum-sort]')];
    const filterButtons = [...document.querySelectorAll('[data-forum-filter]')];
    const searchInput = document.querySelector('[data-forum-search]');
    const list = document.querySelector('.forum-post-list');
    const pagination = document.querySelector('[data-forum-pagination]');
    const pageButtons = document.querySelector('[data-page-buttons]');
    const pageStatus = document.querySelector('[data-page-status]');
    const countStatus = document.querySelector('[data-forum-count]');
    const visibleCount = document.querySelector('[data-forum-visible-count]');
    const emptyState = document.querySelector('[data-forum-empty]');
    const previousButton = document.querySelector('[data-page-previous]');
    const nextButton = document.querySelector('[data-page-next]');
    const pageSize = 20;
    let currentPage = 1;
    let activeFilter = new URLSearchParams(window.location.search).get('category') ?? 'all';

    function updateForum() {
      const sort = sortButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.forumSort ?? 'popular';
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      const ordered = [...cards].sort((a, b) => {
        if (sort === 'latest') return Number(b.dataset.published) - Number(a.dataset.published);
        if (sort === 'top') return Number(b.dataset.comments) - Number(a.dataset.comments);
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
      const matching = ordered.filter((card) => {
        const matchesCategory = activeFilter === 'all' || card.dataset.category === activeFilter;
        return matchesCategory && (!query || card.textContent?.toLocaleLowerCase().includes(query));
      });
      const pageCount = Math.max(1, Math.ceil(matching.length / pageSize));
      currentPage = Math.min(currentPage, pageCount);
      const firstVisible = (currentPage - 1) * pageSize;
      const visibleCards = new Set(matching.slice(firstVisible, firstVisible + pageSize));

      ordered.forEach((card) => {
        card.hidden = !visibleCards.has(card);
        list?.append(card);
      });

      if (countStatus) {
        countStatus.textContent = `${matching.length} ${matching.length === 1 ? labelDiscussion : labelDiscussions}`;
      }
      if (visibleCount) {
        visibleCount.textContent = `${matching.length} ${labelGuide}`;
      }
      if (emptyState) emptyState.hidden = matching.length > 0;
      if (pagination) pagination.hidden = matching.length <= pageSize;
      if (pageStatus) {
        pageStatus.textContent = matching.length
          ? `${labelShowing} ${firstVisible + 1}–${Math.min(firstVisible + pageSize, matching.length)} / ${matching.length}`
          : labelZero;
      }
      if (previousButton) previousButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= pageCount;
      if (pageButtons) {
        pageButtons.replaceChildren(...Array.from({ length: pageCount }, (_, index) => {
          const button = document.createElement('button');
          const page = index + 1;
          button.type = 'button';
          button.textContent = String(page);
          button.setAttribute('aria-label', `${labelPage} ${page}`);
          if (page === currentPage) button.setAttribute('aria-current', 'page');
          button.addEventListener('click', () => {
            currentPage = page;
            updateForum();
          });
          return button;
        }));
      }
    }

    sortButtons.forEach((button) => button.addEventListener('click', () => {
      sortButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      currentPage = 1;
      updateForum();
    }));

    filterButtons.forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.forumFilter ?? 'all';
      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      currentPage = 1;
      updateForum();
    }));

    searchInput?.addEventListener('input', () => {
      currentPage = 1;
      updateForum();
    });
    previousButton?.addEventListener('click', () => {
      currentPage = Math.max(1, currentPage - 1);
      updateForum();
    });
    nextButton?.addEventListener('click', () => {
      currentPage += 1;
      updateForum();
    });

    const initialFilter = filterButtons.find((button) => button.dataset.forumFilter === activeFilter);
    if (initialFilter) {
      filterButtons.forEach((item) => {
        const active = item === initialFilter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
    } else {
      activeFilter = 'all';
    }
    updateForum();
  </script>
  <script>
    import { initForumVotes } from '../scripts/forum-votes.ts';
    initForumVotes();
  </script>
</BaseLayout>
