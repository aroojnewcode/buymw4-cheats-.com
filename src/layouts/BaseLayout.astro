---
import "@/styles/starwind.css";
import {
  getTranslations,
  localeFromPathname,
  localizePath,
  LOCALES,
  LOCALE_META,
  stripLocalePrefix,
  type Locale,
} from '../i18n';
import {
  RSS_FEED_PATH,
  TWITTER_CREATOR,
  TWITTER_SITE,
  canonicalUrl,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  GA_MEASUREMENT_ID,
  absoluteShareImageUrl,
} from '../config/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialShare from '../components/SocialShare.astro';
import { brandIconAltForPath } from '../config/brand-icon-alt';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPathname(Astro.url.pathname);
const t = getTranslations(locale);
const meta = LOCALE_META[locale];

const {
  title = t.site.title,
  description = t.site.description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const barePath = stripLocalePrefix(Astro.url.pathname);
const canonical = canonicalUrl(localizePath(locale, barePath));
const brandIconAlt = brandIconAltForPath(barePath, `${t.site.name} site icon`);
const ogImageUrl = absoluteShareImageUrl(ogImage);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const alternateLocales = LOCALES.map((code) => ({
  hreflang: LOCALE_META[code].hreflang,
  href: canonicalUrl(localizePath(code, barePath)),
}));
const xDefault = canonicalUrl(localizePath('en', barePath));
---

<!doctype html>
<html lang={meta.htmlLang} class="dark fonts-pending">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('colorTheme') || localStorage.getItem('starwind-theme');
          if (stored === 'light') document.documentElement.classList.remove('dark');
          else if (stored === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
        document.documentElement.classList.add('fonts-pending');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      @media (max-width: 639px) {
        .site-header-bar { border-radius: 1rem; }
        main { overflow-x: hidden; }
      }
      @media (min-width: 640px) and (max-width: 1023px) {
        .site-header-nav { gap: 0.25rem; }
      }
      @media (min-width: 1024px) {
        .social-share { justify-content: flex-end; }
      }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={t.site.name} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#7F3DEE" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://ooszazcwzmwhitdxwtom.supabase.co" crossorigin />
    {
      alternateLocales.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.site.name} Blog RSS`}
      href={RSS_FEED_PATH}
    />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      ogImage === DEFAULT_OG_IMAGE && (
        <>
          <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
          <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
        </>
      )
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      LOCALES.filter((code) => code !== locale).map((code) => (
        <meta property="og:locale:alternate" content={LOCALE_META[code].ogLocale} />
      ))
    }

    {
      ogType === 'article' && articlePublishedTime && (
        <>
          <meta property="article:published_time" content={articlePublishedTime} />
          <meta
            property="article:modified_time"
            content={articleModifiedTime ?? articlePublishedTime}
          />
          <meta property="article:author" content={t.site.name} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
    {TWITTER_CREATOR && <meta name="twitter:creator" content={TWITTER_CREATOR} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Manrope:wght@400;500;600&display=optional"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Manrope:wght@400;500;600&display=optional"
        rel="stylesheet"
      />
    </noscript>

    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />

  </head>
  <body class="min-h-screen bg-background text-foreground">
    <button type="button" class="skip-link" data-skip-to-main>{t.ui.skipLink}</button>
    <Header locale={locale} brandIconAlt={brandIconAlt} />
    <main id="main-content">
      <slot />
      <div class="mx-auto max-w-6xl px-5">
        <SocialShare url={canonical} title={title} />
      </div>
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site.ts';
    </script>
    {
      GA_MEASUREMENT_ID && (
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          (() => {
            const loadGa = () => {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag() {
                dataLayer.push(arguments);
              }
              gtag('js', new Date());
              gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
              const s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
              s.async = true;
              document.head.appendChild(s);
            };
            const onReady = () => {
              if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(loadGa, { timeout: 4000 });
              } else {
                window.setTimeout(loadGa, 2500);
              }
            };
            if (document.readyState === 'complete') onReady();
            else window.addEventListener('load', onReady, { once: true });
          })();
        </script>
      )
    }
  </body>
</html>
